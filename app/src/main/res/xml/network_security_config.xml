<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic for your production WordPress site -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Your production WordPress site -->
        <domain includeSubdomains="true">lumiself.co.zw</domain>
    </domain-config>
    
    <!-- Default configuration for other domains - require HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
